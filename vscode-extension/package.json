{
  "name": "mastermind-vscode-extension",
  "displayName": "Mastermind",
  "description": "VS Code extension for compiling .mmi files to Brainfuck.",
  "version": "0.1.0",
  "license": "MIT",
  "publisher": "GroupNameHere (depends we ask Heath next meeting)",
  "engines": {
    "vscode": "^1.110.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mastermindVSCode/mastermind-vscode-extension/vscode-extension"
  },
  "activationEvents": [
    "onLanguage:mastermind"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "mastermind",
        "extensions": [
          ".mmi"
        ],
        "aliases": [
          "Mastermind"
        ]
      }
    ],
    "commands": [
      {
        "command": "mastermind.readMmi",
        "title": "Mastermind: Read .mmi"
      }
    ]
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE.txt"
  ],
  "scripts": {
    "build:extension": "tsc -p ./tsconfig.json",
    "compile": "npm run build",
    "vscode:prepublish": "npm run build",
    "package": "vsce package",
    "lint": "echo \"No lint configured yet\""
  },
  "devDependencies": {
    "@types/vscode": "^1.110.0",
    "typescript": "5.4",
    "vsce": "^2.15.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
