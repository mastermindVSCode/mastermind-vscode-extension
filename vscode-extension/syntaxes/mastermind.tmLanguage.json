{
  "scopeName": "source.mastermind",
  "patterns": [
    {
      "name": "comment.line.mastermind",
      "match": "(//.*$)"
    },
    {
      "name": "string.quoted.double.mastermind",
      "begin": "\"",
      "end": "\""
    },
    {
      "name": "string.quoted.single.mastermind",
      "match": "'[^']*'"
    },
    {
      "name": "constant.numeric.mastermind",
      "match": "\\b\\d+\\b"
    },
    {
      "name": "keyword.control.mastermind",
      "match": "\\b(cell|#include|#define|#ifdef|#ifndef|#endif|struct|fn|if|else|while|input|output|assert|drain|copy|bf|include|into|not|equals|unknown|true|false)\\b"
    },
    {
      "name": "keyword.operator.mastermind",
      "match": "(\\+=|-=|\\+\\+|--|=|\\+|\\-|\\*|@|<|>|\\.|,|\\[|\\]|\\{|\\})"
    },
    {
      "name": "entity.name.type.mastermind",
      "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
    },
    {
      "name": "variable.other.mastermind",
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
    }

  ]
}