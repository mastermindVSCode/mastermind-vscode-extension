{
  "scopeName": "source.mastermind",
  "patterns": [
    {
      "name": "meta.preprocessor.mastermind",
      "match": "^\\s*(#(include|define|ifdef|ifndef|endif))\\b",
      "captures": {
        "1": { "name": "keyword.control.mastermind" },
        "2": { "name": "keyword.control.mastermind" }
      }
    },
    {
      "name": "comment.line.mastermind",
      "match": "(//.*$)"
    },
    {
      "name": "string.quoted.double.mastermind",
      "begin": "\"",
      "end": "\""
    },
    {
      "name": "string.quoted.single.mastermind",
      "match": "'[^']*'"
    },
    {
      "name": "constant.numeric.mastermind",
      "match": "\\b\\d+\\b"
    },
    {
      "name": "keyword.control.mastermind",
      "match": "\\b(cell|extern|struct|fn|if|else|while|input|output|assert|drain|copy|bf|into|not|equals|unknown|true|false|clobbers)\\b|\\B#(include|define|ifdef|ifndef|endif)\\b"
    },
    {
      "name": "keyword.operator.mastermind",
      "match": "(\\+=|-=|\\+\\+|--|=|\\+|\\-|\\*|@|<|>|\\^|v|\\.|,|;|\\(|\\)|\\[|\\]|\\{|\\})"
    },
    {
      "name": "entity.name.type.mastermind",
      "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
    },
    {
      "name": "variable.other.mastermind",
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
    }

  ]
}